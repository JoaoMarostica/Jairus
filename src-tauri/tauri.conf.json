{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jairus",
  "version": "0.1.0",
  "identifier": "com.Jairus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jairus",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/jairus-logos/app-icon/Jairus 0.png",
      "icons/jairus-logos/app-icon/Jairus 1.png",
      "icons/jairus-logos/app-icon/Jairus 2.png",
      "icons/jairus-logos/app-icon/Jairus 3.png",
      "icons/jairus-logos/app-icon/Jairus 4.png",
      "icons/jairus-logos/navbar/Jairus 0.png",
      "icons/jairus-logos/navbar/Jairus 1.jpg",
      "icons/jairus-logos/navbar/Jairus 2.png",
      "icons/jairus-logos/navbar/Jairus 3.png",
      "icons/jairus-logos/navbar/Jairus 4.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
